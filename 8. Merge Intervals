b=[[4,7],[1,4]]
b.sort(key=lambda x: x[0])
result = [b[0]]
#print(result)

for current in b[1:]:
    last = result[-1]
    if current[0] <= last[1]:
        last[1] = max(last[1], current[1])
    else:
        result.append(current)
        
print(result)
