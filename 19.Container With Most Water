class Solution(object):
    def maxArea(self, height):
        """
        :type height: List[int]
        :rtype: int
        """
        left=0
        right=len(height)-1
        max_area=0
        while right > left:
            weight=right-left
            current=min(height[left],height[right])
            area=weight*current
            max_area=max( max_area, area)
            if height[left] < height[right]:
                left += 1
            else:
                right -= 1

        return max_area

