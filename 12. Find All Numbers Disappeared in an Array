class Solution(object):
    def findDisappearedNumbers(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        num_set = set(nums)
        b=[]
        n=len(nums)
        for i in range(1,n+1):
            if i not in num_set:
                b.append(i)
        return b

