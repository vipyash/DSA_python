class Solution(object):
    def groupAnagrams(self, strs):
        """
        :type strs: List[str]
        :rtype: List[List[str]]
        """
        dict={}
        for i in strs:
            sort=" ".join(sorted(i))
            if sort not in dict:
                dict[sort]=[]
            dict[sort].append(i)
        return list(dict.values())


