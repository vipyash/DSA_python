class Solution(object):
    def maxProfit(self, prices):
        """
        :type prices: List[int]
        :rtype: int
        """
        min_prices=prices[0]
        max_profit=0
        for i in range(0,len(prices)):
            profit=prices[i]-min_prices
            max_profit=max(max_profit, profit)
            min_prices=min(min_prices, prices[i])
        

        return max_profit

